# Zoho Mail SMTP — required for contact and newsletter forms
# Generate an app-specific password at: https://accounts.zoho.com/home#security/app_passwords

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=tarcisio@couto.software
# Use single quotes if the password contains $ or other special characters
ZOHO_SMTP_PASSWORD='your-app-password-here'

# Sender and recipient addresses
ZOHO_EMAIL_FROM=support@couto.software
ZOHO_EMAIL_TO=tarcisio@couto.software

# --- Marketplace (boilerplate store) ---

# App base URL (used for Stripe redirects). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Private storage bucket that holds the product .zip files
SUPABASE_PRODUCTS_BUCKET=products
# Direct Postgres connection (port 5432) used by the migration runner (npm run db:migrate)
POSTGRES_URL_NON_POOLING=postgres://postgres.your-ref:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Stripe — Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe CLI / Dashboard webhook signing secret (`npm run stripe:listen`)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Max downloads allowed per purchase (entitlement)
DOWNLOAD_LIMIT=5
